<Window x:Class="IMESupport.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="IMESupport 設定 - AI日本語入力支援"
        Height="780" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#1F2937"/>
        </Style>

        <Style TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Padding" Value="14"/>
            <Setter Property="BorderBrush" Value="#E5E7EB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#111827"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="PasswordBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="BorderBrush" Value="#D1D5DB"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,7"/>
            <Setter Property="Background" Value="#3B82F6"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5" 
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563EB"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Border Grid.Row="0" Margin="0,0,0,14" Background="White" CornerRadius="8" Padding="16,12" BorderBrush="#E5E7EB" BorderThickness="1">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="40" Height="40" Background="#3B82F6" CornerRadius="8" Margin="0,0,14,0">
                    <TextBlock Text="AI" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="IMESupport 設定" FontSize="18" FontWeight="Bold" Foreground="#111827"/>
                    <TextBlock Text="キー2回押しで、同音異義語・誤字・タイピングミスをGemini AIが自動推敲・置換" FontSize="12" Foreground="#6B7280" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- メイン設定タブ/スクロール領域 -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <!-- Gemini API設定 -->
                <GroupBox Header="🔑 Gemini API 設定">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBlock Text="Gemini API キー:" Margin="0,0,0,4" FontWeight="Medium"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <PasswordBox x:Name="PbApiKey" Grid.Column="0" Margin="0,0,8,0"/>
                            <TextBox x:Name="TbApiKeyVisible" Grid.Column="0" Margin="0,0,8,0" Visibility="Collapsed"/>
                            <Button x:Name="BtnToggleApiKey" Grid.Column="1" Content="表示" Width="60" Background="#6B7280" Click="BtnToggleApiKey_Click"/>
                        </Grid>

                        <TextBlock Text="使用モデル:" Margin="0,0,0,4" FontWeight="Medium"/>
                        <ComboBox x:Name="CmbModel" IsEditable="True" Height="32" Margin="0,0,0,8">
                            <ComboBoxItem Content="gemini-3.5-flash-lite" IsSelected="True"/>
                            <ComboBoxItem Content="gemini-2.5-flash"/>
                            <ComboBoxItem Content="gemini-2.0-flash"/>
                            <ComboBoxItem Content="gemini-1.5-flash"/>
                        </ComboBox>
                        <TextBlock Text="※ リストにないモデル名も直接入力して指定可能です。" FontSize="11" Foreground="#6B7280" Margin="0,0,0,10"/>

                        <Button x:Name="BtnTestApi" Content="🔌 API接続テスト" HorizontalAlignment="Left" Background="#10B981" Click="BtnTestApi_Click"/>
                        <TextBlock x:Name="TxtApiStatus" Margin="0,6,0,0" FontSize="12"/>
                    </StackPanel>
                </GroupBox>

                <!-- トリガー・ショートカット設定 -->
                <GroupBox Header="⌨️ ショートカット &amp; キー検知設定">
                    <StackPanel TextElement.FontWeight="Normal">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="トリガーキー:" VerticalAlignment="Center" Margin="0,0,12,0" FontWeight="Medium"/>
                            <ComboBox x:Name="CmbTriggerKey" Grid.Column="1" Height="32" SelectionChanged="CmbTriggerKey_SelectionChanged">
                                <ComboBoxItem Content="Ctrlキー 2回連続押し (おすすめ・IME非干渉・高速)" Tag="CtrlDouble"/>
                                <ComboBoxItem Content="無変換キー 2回連続押し (安定・おすすめ)" Tag="NonConvert"/>
                                <ComboBoxItem Content="変換キー 2回連続押し (※環境により再変換が優先される場合あり)" Tag="Convert"/>
                                <ComboBoxItem Content="Shiftキー 2回連続押し" Tag="ShiftDouble"/>
                                <ComboBoxItem Content="Altキー 2回連続押し" Tag="AltDouble"/>
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="ダブルタップ判定間隔 (ミリ秒):" Margin="0,0,0,4" FontWeight="Medium"/>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="SldInterval" Minimum="200" Maximum="650" SmallChange="10" LargeChange="50" TickFrequency="50" IsSnapToTickEnabled="True" VerticalAlignment="Center" Margin="0,0,10,0" ValueChanged="SldInterval_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=SldInterval, Path=Value, StringFormat={}{0:0} ms}" VerticalAlignment="Center" FontWeight="Bold"/>
                        </Grid>

                        <!-- リアルタイム・キー入力検知モニター -->
                        <Border Background="#F3F4F6" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,4,0,0">
                            <StackPanel>
                                <TextBlock Text="🔍 キー検知ライブモニター（キーを押して動作を確認できます）:" FontSize="11" FontWeight="Bold" Foreground="#374151" Margin="0,0,0,4"/>
                                <TextBlock x:Name="TxtLiveKeyMonitor" Text="ここにキー入力の検知ログがリアルタイム表示されます" FontSize="12" FontFamily="Consolas, Meiryo" Foreground="#2563EB" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </GroupBox>

                <!-- 動作オプション -->
                <GroupBox Header="⚙️ 動作オプション">
                    <StackPanel TextElement.FontWeight="Normal">
                        <CheckBox x:Name="ChkAutoSelectLine" Content="テキスト未選択時、カーソル直前の一行を自動で推敲対象にする" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkShowNotification" Content="推敲・置換完了時やエラー時にデスクトップ通知を表示する（確認用）" Margin="0,0,0,2"/>
                        <TextBlock Text="※ チェックを外すと、通知を出さずに静かに直接置換します（おすすめ）。" FontSize="11" Foreground="#6B7280" Margin="20,0,0,8"/>
                        <CheckBox x:Name="ChkRestoreClipboard" Content="置換後にクリップボードの元の内容を復元する" Margin="0,0,0,8" IsChecked="True"/>
                        <CheckBox x:Name="ChkAutoStart" Content="Windows起動時に自動起動する (スタートアップ登録)" Margin="0,0,0,8"/>
                    </StackPanel>
                </GroupBox>

                <!-- 推敲テストエリア -->
                <GroupBox Header="🧪 動作テスト &amp; プレビュー">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBlock Text="テスト入力文（タイピングミス・誤変換の例）:" Margin="0,0,0,4" FontWeight="Medium"/>
                        <TextBox x:Name="TbTestInput" Height="60" TextWrapping="Wrap" AcceptsReturn="True" 
                                 Text="今日わ変改のテストをして居ます。よろしくおねがいしま。ありがとございます。"/>
                        <Button x:Name="BtnRunTest" Content="✨ AIで推敲テストを実行" Margin="0,8,0,8" HorizontalAlignment="Left" Click="BtnRunTest_Click"/>
                        
                        <TextBlock Text="推敲結果:" Margin="0,4,0,4" FontWeight="Medium"/>
                        <TextBox x:Name="TbTestOutput" Height="60" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Background="#F9FAFB"/>
                    </StackPanel>
                </GroupBox>

                <!-- システムプロンプト編集 -->
                <GroupBox Header="📝 AIプロンプトのカスタマイズ (上級者向け)">
                    <StackPanel TextElement.FontWeight="Normal">
                        <TextBox x:Name="TbPrompt" Height="140" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" FontFamily="Consolas, Meiryo" FontSize="12"/>
                        <Button x:Name="BtnResetPrompt" Content="↺ デフォルトプロンプトに戻す" Margin="0,8,0,0" HorizontalAlignment="Left" Background="#6B7280" Click="BtnResetPrompt_Click"/>
                    </StackPanel>
                </GroupBox>

            </StackPanel>
        </ScrollViewer>

        <!-- フッターボタン -->
        <Border Grid.Row="2" Margin="0,14,0,0" Background="White" CornerRadius="8" Padding="14,10" BorderBrush="#E5E7EB" BorderThickness="1">
            <Grid>
                <TextBlock Text="※ 設定は自動的に保存されます" VerticalAlignment="Center" FontSize="11" Foreground="#9CA3AF"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnSave" Content="💾 保存して閉じる" Width="130" Background="#3B82F6" Click="BtnSave_Click" Margin="0,0,8,0"/>
                    <Button x:Name="BtnClose" Content="閉じる" Width="80" Background="#9CA3AF" Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
