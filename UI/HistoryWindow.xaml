<Window x:Class="IMESupport.UI.HistoryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="推敲履歴 - IMESupport"
        Height="500" Width="700"
        WindowStartupLocation="CenterScreen"
        Background="#F9FAFB"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="📜 推敲履歴一覧" FontSize="16" FontWeight="Bold" Foreground="#111827"/>
                <TextBlock Text="(最新100件まで自動記録)" FontSize="12" Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0"/>
            </StackPanel>
            <Button x:Name="BtnClear" Content="🗑️ 履歴をクリア" HorizontalAlignment="Right" Padding="10,5" Background="#EF4444" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClear_Click"/>
        </Grid>

        <!-- リスト -->
        <ListView x:Name="LvHistory" Grid.Row="1" Background="White" BorderBrush="#E5E7EB" SelectionMode="Single">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="時刻" Width="80" DisplayMemberBinding="{Binding FormattedTime}"/>
                    <GridViewColumn Header="元の文章" Width="260" DisplayMemberBinding="{Binding OriginalText}"/>
                    <GridViewColumn Header="修正後の文章" Width="260" DisplayMemberBinding="{Binding CorrectedText}"/>
                    <GridViewColumn Header="ステータス" Width="80" DisplayMemberBinding="{Binding Status}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- フッター -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <TextBlock Text="※ 行を選択して「コピー」をクリックすると修正後の文章をクリップボードにコピーできます" VerticalAlignment="Center" FontSize="11" Foreground="#6B7280"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnCopy" Content="📋 修正文をコピー" Padding="12,6" Margin="0,0,8,0" Background="#3B82F6" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnCopy_Click"/>
                <Button x:Name="BtnClose" Content="閉じる" Width="70" Padding="12,6" Background="#9CA3AF" Foreground="White" BorderThickness="0" Cursor="Hand" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
